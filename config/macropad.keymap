#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "media";
            bindings = <
                &lt C_MUTE 1
                &kp C_PP
                &kp C_PREV 
                &kp C_NEXT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        o3c_layer {
            label = "o3c";
            bindings = <
                &kp 2
                &kp X
                &kp Y
                &kp SPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        sec_layer {
            label = "sec";
            bindings = <
                &kp 1
                &bt BT_CLR
                &bt BT_NXT
                &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };


        /*
         * Hold any key + encoder push to switch to this layer
         * Uncomment and wire up a hold-tap if you want a second layer
         */
        /* fn_layer { */
        /*     label = "Fn"; */
        /*     bindings = < */
        /*         &bt BT_CLR */
        /*         &bt BT_SEL 0 */
        /*         &bt BT_SEL 1 */
        /*         &bt BT_SEL 2 */
        /*     >; */
        /*     sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>; */
        /* }; */
    };
};
