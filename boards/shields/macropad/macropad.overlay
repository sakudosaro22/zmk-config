/*
 * Macropad Shield Overlay
 * Hardware: Nice!Nano v2
 * Layout: 1x rotary encoder (top-left) + 3x MX switches (bottom row)
 *
 * Wiring:
 *   Rows:    Row0 (encoder row) → D3 | Row1 (key row) → D2
 *   Columns: Col0 → D4 | Col1 → D5 | Col2 → D6
 *   Encoder: A → D21 | B → D20  (push button is at R0,C0 in matrix)
 *
 * Matrix layout:
 *        Col0    Col1    Col2
 *  Row0  [ENC]   [    ]  [    ]   ← only RC(0,0) is wired (encoder push)
 *  Row1  [ K1]   [ K2 ]  [ K3 ]
 */
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zephyr,display = &oled;
    };

    /* ── Key matrix (GPIO matrix scan) ─────────────────────────
     *
     *  ROW pins (output / driven):
     *    Row 0  →  D3  (&pro_micro 3)
     *    Row 1  →  D2  (&pro_micro 2)
     *
     *  COL pins (input / sense):
     *    Col 0  →  D4  (&pro_micro 4)
     *    Col 1  →  D5  (&pro_micro 5)
     *    Col 2  →  D6  (&pro_micro 6)
     *
     *  Wire diodes cathode-to-row (ROW2COL) as usual.
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";
        row-gpios
            = <&pro_micro 3 GPIO_ACTIVE_HIGH>   /* Row 0 – D3 (encoder push row) */
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>   /* Row 1 – D2 (key row)          */
            ;
        col-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 0 – D4 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 1 – D5 */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 2 – D6 */
            ;
    };

    /* ── Matrix transform ───────────────────────────────────────
     *
     *  Physical layout mapped to keymap positions:
     *
     *    RC(0,0)                        ← encoder push (top-left)
     *    RC(1,0)  RC(1,1)  RC(1,2)     ← K1  K2  K3
     */
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows    = <2>;
        map = <
            RC(0,0)
            RC(1,0) RC(1,1) RC(1,2)
        >;
    };

    /* ── Rotary encoder ─────────────────────────────────────────
     *
     *  A → D20  (&pro_micro 21  =  P0.31)
     *  B → D21  (&pro_micro 20  =  P0.29)
     *
     *  The encoder push switch sits at RC(0,0) in the matrix above.
     */
    encoder_0: encoder_0 {
        compatible = "alps,ec11";
        label = "ENCODER_0";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D21 */
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D20 */
        steps = <80>;   /* pulses per revolution – tune to your encoder */
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors    = <&encoder_0>;
        triggers-per-rotation = <20>;
    };
};

/* ── I2C OLED display ────────────────────────────────────────────
 *
 *  SDA → D0 (&pro_micro 0)
 *  SCL → D1 (&pro_micro 1)
 *  VCC → 3.3V
 *  GND → GND
 *
 *  These pin/label blocks must live OUTSIDE the root "/ { ... }"
 *  node, as top-level overrides of existing nodes.
 */
&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>, <NRF_PSEL(TWIM_SCL, 0, 15)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 13)>, <NRF_PSEL(TWIM_SCL, 0, 15)>;
            low-power-enable;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    pinctrl-1 = <&i2c0_default>;
    pinctrl-0 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
};
