#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix_transform = &default_transform;
        zephyr,display = &oled;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "row2col";
        row-gpios
            = <&pro_micro 0 GPIO_ACTIVE_HIGH>
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>
            ;
        col-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 0 – D4 */
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 1 – D5 */
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   /* Col 2 – D6 */
            ;
    };

    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows    = <2>;
        map = <
            RC(0,0)
            RC(1,0) RC(1,1) RC(1,2)
        >;
    };

    encoder_0: encoder_0 {
        compatible = "alps,ec11";
        label = "ENCODER_0";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D21 */
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;  /* D20 */
        steps = <80>;   /* pulses per revolution – tune to your encoder */
        status = "okay";
    };

    sensors {
        compatible = "zmk,keymap-sensors";
        sensors    = <&encoder_0>;
        triggers-per-rotation = <20>;
    };

};

/* ── I2C OLED display ────────────────────────────────────────────
 *
 *  Uses the nice!nano v2's built-in hardware I2C bus, exposed via
 *  the pro_micro_i2c alias. This bus is physically wired to D2
 *  (SDA) and D3 (SCL) — the same pattern used by every official
 *  ZMK shield with an OLED (lily58, corne, etc).
 */
&pro_micro_i2c {
    status = "okay";

    oled: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        reg = <0x3c>;
        width = <128>;
        height = <64>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        inversion-on;
        prechargep = <0x22>;
    };
};
